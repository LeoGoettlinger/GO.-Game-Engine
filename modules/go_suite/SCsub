#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

env_go_suite = env_modules.Clone()
module_obj = []

# The module is absent from export templates; config.py already gates it on
# env.editor_build. Keep the guard so a custom editor-less build is safe.
if env.editor_build:
    # Project setup is called by libeditor, which follows module archives on
    # Linux's link line. Compile that adapter into libeditor (editor/SCsub).
    env_go_suite.add_source_files(
        module_obj, [source for source in Glob("*.cpp") if source.name != "go_project_setup.cpp"]
    )
    # tests/standalone_guardrails.cpp is intentionally NOT compiled here:
    # misc/scripts/go_run_guardrails.py builds it without Godot headers.

env.modules_sources += module_obj
